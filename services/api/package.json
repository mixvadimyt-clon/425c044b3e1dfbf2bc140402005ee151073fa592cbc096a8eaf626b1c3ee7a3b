{
  "name": "@inspector/api",
  "private": true,
  "version": "0.1.0",
  "description": "«Продукт» — backend (Node.js + Fastify, OpenAPI design-first)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./var src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "gen": "openapi-typescript ../../contracts/dist/inspector-api.v1.json -o src/generated/api.d.ts && openapi-typescript ../../contracts/dist/ml-events.v1.json -o src/generated/events.d.ts && openapi-typescript ../../contracts/dist/rin-external.v1.json -o src/generated/rin.d.ts",
    "test": "vitest run",
    "db:reset": "tsx src/db/reset.ts",
    "matrix:import": "tsx src/cli/matrix-import.ts",
    "import:dir": "tsx src/cli/import-dir.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.4",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pdfmake": "^0.3.3",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
