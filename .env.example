# Скопируйте в .env (он в .gitignore): cp .env.example .env
# Локальный режим по умолчанию: БЕЗ Docker. SQLite + файлы в var/, api ⇄ ml по HTTP.

# --- api (services/api)
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000     # адрес api для callback от ml
JWT_SECRET=change-me-dev-only
JWT_TTL_SECONDS=28800
DB_PATH=var/inspector.sqlite            # относительно корня репозитория
STORAGE_DIR=var/storage                 # общий для api и ml: raw/{sha256}, parsed/...
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_BATCH_MB=200
# Выгрузка submission: гипотезы свободного поиска (FREE-*) с уверенностью ниже порога не выгружаются
SUBMISSION_FREE_MIN_CONFIDENCE=0.5
MATRIX_CSV=data/matrix/params.csv
MATRIX_ACTIVE_PARAMS=all                # все 132 параметра Приложения 1; или список кодов: M-002,M-055
CORS_ORIGIN=*
LOG_LEVEL=info

# --- связь api → ml
# stub — ML-заглушка внутри api (фронтенд и демо без Python); http — реальный services/ml
ML_TRANSPORT=stub
ML_URL=http://localhost:8000
ML_STUB_DELAY_MS=1500
ML_JOB_TIMEOUT_S=600
ML_MAX_RETRIES=2
INTERNAL_TOKEN=                          # если задан — ml обязан присылать его в x-internal-token
IMPORT_ROOT=dataset                      # откуда разрешён серверный импорт комплектов (npm run import:dir)

# --- обмен с внешней ИС надзора (ИАИС «РиН»), мок — services/rin-mock
# Пусто — обмен выключен. Локально: RIN_URL=http://localhost:4020 и ./scripts/start-local.sh поднимет мок сам
RIN_URL=
RIN_TOKEN=dev-rin-token                  # bearer-токен (мок сертификата УКЭП); мок проверяет тот же
RIN_SECRET=dev-rin-secret                # подпись x-signature = HMAC-SHA256 тела; мок проверяет тот же
RIN_SYSTEM_NAME=ИАИС «РиН»               # название в сообщениях (на встрече звучало «ИАС СТРИН»)
RIN_POLL_INTERVAL_S=60                   # автозабор пакетов документов; 0 — только кнопкой / POST /integration/pull
RIN_AUTO_PUSH=true                       # отправлять результаты сразу после финализации
RIN_RETRY_DELAYS_S=60,300,900            # повторы на 5xx и таймаут: 1, 5, 15 минут (REQ-INT-03)
RIN_TIMEOUT_S=30
# мок: RIN_MOCK_PORT=4020, RIN_MOCK_PACKAGES_DIR=var/rin-mock/packages, RIN_MOCK_FAIL=error:2 (первые две отправки — 503)

# --- ml (services/ml)
ML_HOST=127.0.0.1
ML_PORT=8000
API_URL=http://localhost:3000
# PARSER_VERSION не задаём: версия разбора живёт в services/ml (config.py), кеш ищется по sha256 + версии,
# и устаревшее значение здесь молча отключало бы кеш у каждого файла
# учётка ML-инженера для `inspector-ml train` — выгрузка набора и регистрация модели;
# локально пароль демо-пользователя равен логину
ML_API_LOGIN=ml
ML_API_PASSWORD=ml
CACHE_DIR=var/cache                      # кеш парсинга по sha256 (REDIS_URL — опционально)
OCR_ENGINE=paddle                        # paddle | tesseract | none
OCR_DPI=300
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Sentence-BERT — запасной путь извлечения числовых параметров; нужен extra embeddings. Бюджет — секунд на задачу
SBERT_ENABLED=false
# основной лимит — подписей на задачу (детерминированный); бюджет по часам — аварийный
SBERT_MAX_LABELS=30000
SBERT_BUDGET_S=1800
# Qwen через OpenAI-совместимый API: vLLM на сервере, локально — Ollama (http://localhost:11434/v1)
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local
MODEL_VERSION=rules-0.1.0
DATASET_VERSION=none

# --- web (services/web, Vite читает только VITE_*)
VITE_API_URL=http://localhost:3000

# --- ОПЦИОНАЛЬНО (полный контур из ТЗ; локально не нужно)
# REDIS_URL=redis://localhost:6379
# AMQP_URL=amqp://inspector:inspector@localhost:5672
# CLAMAV_ENABLED=true
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
