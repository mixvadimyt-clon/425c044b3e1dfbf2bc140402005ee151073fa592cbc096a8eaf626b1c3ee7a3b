# Настройки стенда для docker-compose.app.yml. Скопируйте в .env.stand (в git не попадает) и задайте секреты:
#   cp infra/stand/stand.env.example .env.stand && openssl rand -hex 32   # для JWT_SECRET и INTERNAL_TOKEN

# --- адрес: «:80» — без TLS; доменное имя (или IP через sslip.io: 51-250-10-20.sslip.io) — HTTPS от Let's Encrypt
SITE_ADDRESS=:80

# --- секреты (обязательно)
JWT_SECRET=
INTERNAL_TOKEN=
# пароль демо-пользователей inspector / supervisor / admin / ml — задаётся при ПЕРВОМ запуске (пустая база)
DEMO_PASSWORD=
# ML_API_PASSWORD= — пароль учётки `ml` для `inspector-ml train`; по умолчанию DEMO_PASSWORD
# OPEN_ACCESS=true — вход без пароля: на странице входа кнопки ролей. Только на время экспертизы
#   (просьба организаторов 29.09); роли и журнал действий остаются. По умолчанию выключен

# --- распознавание: значения по умолчанию задаёт compose, и они разные для двух вариантов.
# docker-compose.app.yml — процессор (ADR-0007): OCR_DEVICE=cpu, OCR_MAX_PAGES=30, ML_WORKERS=2.
# docker-compose.gpu.yml — видеокарта: OCR_DEVICE=auto, OCR_MAX_PAGES=0 (без предела), ML_WORKERS=4.
#
# Здесь их задавать НЕЛЬЗЯ: значение из --env-file приходит раньше, чем `${OCR_DEVICE:-auto}`
# в надстройке, поэтому `./start.sh --gpu` молча распознавал бы на процессоре. Поймано 22.09
# на RTX 3050: страница скана ИД — 34 с против 2 с на карте, и 494 страницы исполнительной
# документации вместо 17 минут считались бы почти пять часов.
#
# Снимайте комментарий только чтобы осознанно перебить оба варианта.
# OCR_DEVICE=cpu
# OCR_MAX_PAGES=30
# ML_WORKERS=2
# Sentence-BERT: образ ML собирается с ним (ML_EXTRAS="ocr embeddings"), включается флагом. Каждый процесс
# ML с ним держит около 1 ГБ памяти: на ВМ с 8 ГБ включать вместе с ML_WORKERS=1. Образ без него — ML_EXTRAS=ocr.
# SBERT_ENABLED=false
# ML_EXTRAS=ocr embeddings
#
# Потолок процессора для ml, ядер. ./start.sh в варианте cpu сам отдаёт ML половину ядер Docker:
# PaddleOCR берёт все ядра на каждого воркера, и без потолка скан держал 400 % на 4 ядрах.
# Задайте, чтобы перебить; 0 — без потолка.
# ML_CPUS=2
MATRIX_ACTIVE_PARAMS=all

# --- MLflow: витрина ML-контура по /mlflow/, вход из админки. `./start.sh --mlflow` сам
# допишет сюда профиль; вместе с мониторингом — COMPOSE_PROFILES=monitoring,mlops
# COMPOSE_PROFILES=mlops

# --- журнал действий пользователей: в базе он есть всегда, файл — копия строками JSON.
# Вебхук и Telegram выключены намеренно: закрытый контур, 152-ФЗ. Включать осознанно.
AUDIT_FILE=/data/audit.jsonl
AUDIT_WEBHOOK_URL=
AUDIT_TELEGRAM_TOKEN=
AUDIT_TELEGRAM_CHAT=
# адрес api.telegram.org, который отвечает из облака (по умолчанию 149.154.167.220, см. docker-compose.app.yml)
AUDIT_TELEGRAM_IP=

# --- папка с комплектами на ВМ для серверного импорта и пакетов мока «РиН» (монтируется только на чтение)
IMPORT_DIR=./dataset

# --- обмен с внешней ИС (мок в том же compose); пусто — обмен выключен
RIN_URL=http://rin-mock:4020
RIN_TOKEN=
RIN_SECRET=
RIN_SYSTEM_NAME=ИАИС «РиН»
RIN_POLL_INTERVAL_S=60

# --- мониторинг (docker compose --profile monitoring): Grafana только на 127.0.0.1:3001
GRAFANA_PASSWORD=
