{
  "openapi": "3.0.3",
  "info": {
    "title": "ИАИС «РиН» — API внешней ИС для «Инспектора ИИ» (мок)",
    "version": "0.1.0",
    "description": "Как «Инспектор ИИ» обменивается данными с внешней информационной системой надзора (в ТЗ — ИАИС «РиН»).\nНастоящего API нет, поэтому это контракт нашей стороны: по нему работают мок-сервис `services/rin-mock` и коннекторы api\n(`services/api/src/modules/integration/`). Название системы в сообщениях настраивается (`RIN_SYSTEM_NAME`).\n\nДва направления:\n- **документы → Инспектор** (REQ-INT-06): api периодически забирает новые пакеты (`GET /api/v1/packages`),\n  скачивает файлы и запускает проверку. Если протокол объекта финализирован, проверка не запускается —\n  инспектор получает уведомление и сам решает, создавать ли новую;\n- **результаты → внешняя ИС** (REQ-INT-01…05): после финализации api отправляет подтверждённые нарушения,\n  версии протокола, матрицы и модели и реестр входных файлов (`POST /api/v1/results`). На 5xx и таймаут —\n  три повтора через 1, 5 и 15 минут; пока не доставлено — `sync_status = PENDING_SYNC`.\n\nАутентификация (REQ-INT-02): в проде — клиентский сертификат (УКЭП) и подпись запроса. В моке —\nbearer-токен и заголовок `x-signature` = HMAC-SHA256 тела запроса общим секретом (hex).\n",
    "license": {
      "name": "Proprietary",
      "url": "https://github.com/mixvadimyt-clon/425c044b3e1dfbf2bc140402005ee151073fa592cbc096a8eaf626b1c3ee7a3b"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4020",
      "description": "services/rin-mock (dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "packages",
      "description": "Пакеты документов для проверки (внешняя ИС → Инспектор)"
    },
    {
      "name": "results",
      "description": "Результаты проверок (Инспектор → внешняя ИС)"
    },
    {
      "name": "system",
      "description": "Служебные эндпоинты"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "rinHealth",
        "summary": "Живость внешней ИС",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "system": {
                      "type": "string",
                      "example": "ИАИС «РиН» (мок)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/packages": {
      "get": {
        "tags": [
          "packages"
        ],
        "operationId": "listPackages",
        "summary": "Пакеты документов, готовые к проверке",
        "description": "Все пакеты или только появившиеся после `since`. Инспектор помнит обработанные `package_id`,\nпоэтому повторная выдача пакета безопасна.\n",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/packages/{package_id}/files/{file_index}": {
      "get": {
        "tags": [
          "packages"
        ],
        "operationId": "downloadPackageFile",
        "summary": "Содержимое файла пакета",
        "parameters": [
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file_index",
            "in": "path",
            "required": true,
            "description": "Номер файла в пакете (с 0, как в `Package.files`); реестр — `registry`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Файл как есть",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Нет такого пакета или файла",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RinError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/results": {
      "post": {
        "tags": [
          "results"
        ],
        "operationId": "receiveInspectionResult",
        "summary": "Принять результат проверки (REQ-INT-01…05)",
        "description": "Идемпотентно по `x-idempotency-key` (у Инспектора — `<process_id>:v<версия протокола>`):\nповтор с тем же ключом возвращает ту же квитанцию с `duplicate = true` и кодом 200.\nЕсли есть подтверждённые нарушения, внешняя ИС регистрирует предписание в статусе `ISSUED` (REQ-INT-07).\n",
        "parameters": [
          {
            "name": "x-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "in": "header",
            "required": false,
            "description": "HMAC-SHA256 тела запроса общим секретом, hex (мок подписи УКЭП, REQ-INT-02)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectionResult"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Уже принят ранее (тот же ключ идемпотентности)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Принят",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Тело не соответствует контракту или неверная подпись",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RinError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "description": "Внешняя ИС недоступна — Инспектор повторит отправку",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RinError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "results"
        ],
        "operationId": "listReceivedResults",
        "summary": "Принятые результаты (для проверки обмена и демо)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultReceipt"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Токен, выданный Инспектору внешней ИС (в проде — клиентский сертификат УКЭП)"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Нет или неверный токен",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RinError"
            }
          }
        }
      }
    },
    "schemas": {
      "RinError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "UNAVAILABLE"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExternalObject": {
        "type": "object",
        "description": "Объект капитального строительства во внешней ИС",
        "required": [
          "object_id",
          "name"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "description": "Идентификатор объекта во внешней ИС — у Инспектора это `ObjectInfo.external_id`",
            "example": "ALT79B"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "customer": {
            "type": "string",
            "nullable": true
          },
          "contractor": {
            "type": "string",
            "nullable": true
          },
          "permit_number": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PackageFile": {
        "type": "object",
        "required": [
          "name",
          "rel_path",
          "size_bytes",
          "sha256",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "rel_path": {
            "type": "string",
            "description": "Путь внутри пакета через «/» — по нему файл сопоставляется со строкой реестра"
          },
          "size_bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "description": "Инспектор сверяет с полученным содержимым; расхождение — пакет не принимается"
          },
          "url": {
            "type": "string",
            "description": "Путь для скачивания относительно базового URL внешней ИС"
          }
        }
      },
      "Package": {
        "type": "object",
        "required": [
          "package_id",
          "created_at",
          "object",
          "files"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "object": {
            "$ref": "#/components/schemas/ExternalObject"
          },
          "registry": {
            "description": "Реестр файлов комплекта (CSV / XLSX / JSON / JSONL, «Перечень ИД» ред. 1.1); без него полнота — CLARIFICATION_REQUIRED",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PackageFile"
              }
            ],
            "nullable": true
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageFile"
            }
          }
        }
      },
      "PackageList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Package"
            }
          }
        }
      },
      "ResultReceipt": {
        "type": "object",
        "required": [
          "receipt_id",
          "received_at",
          "process_id",
          "protocol_version",
          "duplicate"
        ],
        "properties": {
          "receipt_id": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "process_id": {
            "type": "string",
            "format": "uuid"
          },
          "protocol_version": {
            "type": "integer"
          },
          "confirmed_violations": {
            "type": "integer"
          },
          "duplicate": {
            "type": "boolean",
            "description": "Результат с этим ключом идемпотентности уже был принят"
          },
          "prescription": {
            "type": "object",
            "nullable": true,
            "description": "Предписание, заведённое по подтверждённым нарушениям (REQ-INT-07)",
            "required": [
              "prescription_id",
              "status"
            ],
            "properties": {
              "prescription_id": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/PrescriptionStatus"
              }
            }
          }
        }
      },
      "PrescriptionStatus": {
        "type": "string",
        "description": "Статусы предписаний ИАИС «РиН» (REQ-INT-07)",
        "enum": [
          "ISSUED",
          "IN_PROGRESS",
          "COMPLETED",
          "CANCELLED",
          "EXTENDED"
        ]
      },
      "ObjectCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "customer": {
            "type": "string",
            "description": "Застройщик / технический заказчик"
          },
          "contractor": {
            "type": "string"
          },
          "permit_number": {
            "type": "string",
            "description": "Номер разрешения на строительство"
          },
          "external_id": {
            "type": "string",
            "nullable": true,
            "description": "Идентификатор объекта во внешнем реестре / датасете (object_id разметки)"
          }
        }
      },
      "ObjectIndicator": {
        "type": "string",
        "description": "Светофор дашборда. RED — есть CONFIRMED_VIOLATION; YELLOW — есть необработанные CANDIDATE,\nCLARIFICATION_REQUIRED или MISSING_EVIDENCE; GREEN — иначе.\n",
        "enum": [
          "GREEN",
          "YELLOW",
          "RED"
        ]
      },
      "ProcessStatus": {
        "type": "string",
        "description": "Статус процесса проверки (REQ-PRC-01); FAILED — расширение ТЗ",
        "enum": [
          "PENDING",
          "PARSING",
          "READY",
          "VERIFYING",
          "COMPLETED",
          "FINALIZED",
          "FAILED"
        ]
      },
      "FindingCounts": {
        "type": "object",
        "properties": {
          "params_total": {
            "type": "integer"
          },
          "candidates": {
            "type": "integer"
          },
          "candidates_pending": {
            "type": "integer"
          },
          "confirmed_violations": {
            "type": "integer"
          },
          "negative_verified": {
            "type": "integer"
          },
          "missing_evidence": {
            "type": "integer"
          },
          "not_applicable": {
            "type": "integer"
          },
          "not_comparable": {
            "type": "integer"
          },
          "clarification_required": {
            "type": "integer"
          },
          "suspicions": {
            "type": "integer"
          },
          "compliance_percent": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100,
            "description": "«Соответствие» для шапки UI: доля сопоставимых проверок без расхождения,\nNEGATIVE_VERIFIED / (NEGATIVE_VERIFIED + CANDIDATE + CONFIRMED_VIOLATION) × 100.\nnull — нет ни одной сопоставимой проверки.\n"
          }
        }
      },
      "ObjectInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ObjectCreate"
          },
          {
            "type": "object",
            "required": [
              "id",
              "indicator",
              "created_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "indicator": {
                "$ref": "#/components/schemas/ObjectIndicator"
              },
              "last_process_id": {
                "type": "string",
                "format": "uuid",
                "nullable": true
              },
              "last_process_status": {
                "type": "string",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ProcessStatus"
                  }
                ],
                "nullable": true
              },
              "counts": {
                "$ref": "#/components/schemas/FindingCounts"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "VersionSet": {
        "type": "object",
        "description": "Версии, фиксируемые в каждом запуске и протоколе (REQ-CMP-02)",
        "required": [
          "matrix_version",
          "model_version",
          "dataset_version",
          "input_manifest_hash"
        ],
        "properties": {
          "matrix_version": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "dataset_version": {
            "type": "string"
          },
          "parser_version": {
            "type": "string"
          },
          "input_manifest_hash": {
            "type": "string",
            "description": "SHA-256 от отсортированного списка sha256 входных файлов"
          }
        }
      },
      "FindingStatus": {
        "type": "string",
        "description": "Статус finding в протоколе (REQ-CMP-13). CONFIRMED_VIOLATION ставит только инспектор.",
        "enum": [
          "NEGATIVE_VERIFIED",
          "CANDIDATE",
          "CONFIRMED_VIOLATION",
          "MISSING_EVIDENCE",
          "NOT_APPLICABLE",
          "NOT_COMPARABLE",
          "CLARIFICATION_REQUIRED",
          "SUSPICION"
        ]
      },
      "CompletenessStatus": {
        "type": "string",
        "description": "Комплектность доказательств (схема GOLD, Приложение 1), отдельно от finding_status:\nCOMPLETE — все нужные источники есть и сопоставимы; MISSING_EVIDENCE — обязательного источника нет;\nNOT_APPLICABLE — параметр неприменим (с основанием); NOT_COMPARABLE — файл нечитаем или листы не сопоставлены;\nCLARIFICATION_REQUIRED — нет реестра или несколько редакций без однозначного статуса.\n",
        "enum": [
          "COMPLETE",
          "MISSING_EVIDENCE",
          "NOT_APPLICABLE",
          "NOT_COMPARABLE",
          "CLARIFICATION_REQUIRED"
        ]
      },
      "DocStage": {
        "type": "string",
        "description": "Стадия документации — ПД / РД / ИД",
        "enum": [
          "PD",
          "RD",
          "ID"
        ]
      },
      "StageComparison": {
        "type": "object",
        "description": "Сравнение значения одной стадии с эталоном ПД",
        "required": [
          "stage",
          "triggered"
        ],
        "properties": {
          "stage": {
            "$ref": "#/components/schemas/DocStage"
          },
          "value": {
            "type": "string",
            "nullable": true,
            "description": "Нормализованное значение стадии («11905.3», «B25»)"
          },
          "raw_value": {
            "type": "string",
            "nullable": true,
            "description": "Как записано в документе («11 905,3»)"
          },
          "delta": {
            "type": "string",
            "nullable": true,
            "description": "«-575.3 (-4.61 %)», «понижение на 1 ступ.»"
          },
          "triggered": {
            "type": "boolean",
            "description": "Сработал ли триггер матрицы на этой стадии"
          },
          "verdict": {
            "type": "string",
            "nullable": true,
            "description": "Вывод по стадии («Отклонение 4.61 % больше порога 1 %»)"
          }
        }
      },
      "ReviewPriority": {
        "type": "string",
        "description": "Только очерёдность экспертной проверки, не юридическое действие",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ]
      },
      "RationaleSource": {
        "type": "string",
        "description": "Кто сформулировал обоснование — правила или LLM (Qwen)",
        "enum": [
          "RULES",
          "LLM"
        ]
      },
      "EvidenceRole": {
        "type": "string",
        "enum": [
          "EXPECTED",
          "ACTUAL",
          "CONTEXT"
        ]
      },
      "ApprovalStatus": {
        "type": "string",
        "description": "Статус утверждения редакции (реестр файлов, «Перечень ИД» ред. 1.1):\nDRAFT — черновик, эталоном не служит; APPROVED — утверждена; FOR_CONSTRUCTION — выдана «В производство работ»;\nSUPERSEDED — заменена новой редакцией (хранится для аудита, из эталонного сравнения исключается);\nCANCELLED — аннулирована (исключается); UNKNOWN — реестра нет и ML не определил статус.\n",
        "enum": [
          "DRAFT",
          "APPROVED",
          "FOR_CONSTRUCTION",
          "SUPERSEDED",
          "CANCELLED",
          "UNKNOWN"
        ]
      },
      "BBox": {
        "type": "array",
        "description": "[x0, y0, x1, y1] в долях [0;1] видимой страницы, начало — левый верхний угол",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "Polygon": {
        "type": "array",
        "description": "Точки [[x, y], ...] в той же системе координат, что и BBox",
        "minItems": 3,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "TextSource": {
        "type": "string",
        "description": "MANUAL — область указана инспектором вручную",
        "enum": [
          "TEXT_LAYER",
          "OCR",
          "DOCX",
          "XML",
          "MANUAL"
        ]
      },
      "ExtractionMethod": {
        "type": "string",
        "description": "Как найдено значение фрагмента (0.23.0). RULES — правила матрицы и извлекатели ML;\nSBERT — запасной путь по смысловой близости подписи к названию параметра (Sentence-BERT,\nфлаг SBERT_ENABLED). Не путать с TextSource: тот говорит, откуда текст (слой, OCR), а этот —\nкак в тексте нашли значение.\n",
        "enum": [
          "RULES",
          "SBERT"
        ]
      },
      "PageQuality": {
        "type": "string",
        "description": "Качество распознавания страницы/зоны (REQ-PRS-03)",
        "enum": [
          "OK",
          "LOW_QUALITY",
          "ABSTAIN"
        ]
      },
      "EvidenceFragment": {
        "type": "object",
        "description": "Доказательный фрагмент с координатами (REQ-PRS-06, REQ-CMP-09)",
        "required": [
          "role",
          "file_id",
          "sha256",
          "stage",
          "page",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/EvidenceRole"
          },
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/DocStage"
          },
          "document_code": {
            "type": "string",
            "nullable": true
          },
          "revision": {
            "type": "string",
            "nullable": true
          },
          "approval_status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "sheet": {
            "type": "string",
            "nullable": true,
            "description": "Номер листа по штампу (может отличаться от номера страницы PDF)"
          },
          "bbox": {
            "$ref": "#/components/schemas/BBox"
          },
          "polygon": {
            "type": "array",
            "allOf": [
              {
                "$ref": "#/components/schemas/Polygon"
              }
            ],
            "nullable": true
          },
          "extracted_value": {
            "type": "string",
            "nullable": true,
            "description": "Значение как в документе"
          },
          "normalized_value": {
            "type": "string",
            "nullable": true,
            "description": "Нормализованное значение (число в базовых единицах, марка и т.п.)"
          },
          "text_snippet": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "$ref": "#/components/schemas/TextSource"
          },
          "extraction_method": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExtractionMethod"
              }
            ],
            "nullable": true,
            "description": "null — RULES (протоколы до 0.23.0 и области, указанные инспектором вручную)"
          },
          "quality": {
            "$ref": "#/components/schemas/PageQuality"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "EvidenceGroup": {
        "type": "object",
        "required": [
          "id",
          "fragments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fragments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceFragment"
            }
          }
        }
      },
      "EvidenceSource": {
        "type": "string",
        "description": "Кто сформировал версию доказательств",
        "enum": [
          "MODEL",
          "INSPECTOR"
        ]
      },
      "EvidenceVersion": {
        "type": "object",
        "required": [
          "group_id",
          "version",
          "source",
          "created_at",
          "fragments_count"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "created_by": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "created_by_name": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "reference": {
            "type": "string",
            "nullable": true
          },
          "fragments_count": {
            "type": "integer"
          }
        }
      },
      "InspectorStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "CONFIRMED_VIOLATION",
          "NEGATIVE_VERIFIED",
          "CLARIFICATION_REQUIRED"
        ]
      },
      "InspectorAction": {
        "type": "string",
        "description": "CONFIRM → CONFIRMED_VIOLATION, REJECT → NEGATIVE_VERIFIED, CLARIFY → CLARIFICATION_REQUIRED",
        "enum": [
          "CONFIRM",
          "REJECT",
          "CLARIFY"
        ]
      },
      "ReasonCode": {
        "type": "string",
        "description": "Кодированная причина отклонения (REQ-VER-03)",
        "enum": [
          "WRONG_REVISION",
          "APPROVED_CHANGE",
          "OCR_ERROR",
          "LINKING_ERROR",
          "EXTRACTION_ERROR",
          "PARAMETER_NOT_APPLICABLE",
          "NO_DISCREPANCY",
          "OTHER"
        ]
      },
      "FindingDecision": {
        "type": "object",
        "required": [
          "action",
          "resulting_status",
          "user_id",
          "decided_at"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/InspectorAction"
          },
          "resulting_status": {
            "$ref": "#/components/schemas/InspectorStatus"
          },
          "reason_code": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/ReasonCode"
              }
            ],
            "nullable": true
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "approved_change_ref": {
            "type": "string",
            "nullable": true
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_name": {
            "type": "string"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Finding": {
        "type": "object",
        "description": "Строка таблицы Checks + карточка доказательства (REQ-CMP-09)",
        "required": [
          "id",
          "finding_key",
          "protocol_id",
          "param_code",
          "finding_status",
          "completeness_status",
          "inspector_status",
          "review_priority",
          "evidence_group"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "finding_key": {
            "type": "string",
            "description": "Стабильный ключ между версиями протокола (sha1(object_id|param_code|rule_key))"
          },
          "protocol_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_id": {
            "type": "string",
            "format": "uuid"
          },
          "param_id": {
            "type": "integer",
            "nullable": true
          },
          "param_code": {
            "type": "string",
            "description": "Код параметра матрицы (M-055) или логического правила (RULE-…)"
          },
          "param_name": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "rule_key": {
            "type": "string",
            "nullable": true,
            "description": "Ключ атомарного правила внутри параметра (например номер помещения/элемента)"
          },
          "finding_status": {
            "$ref": "#/components/schemas/FindingStatus"
          },
          "completeness_status": {
            "$ref": "#/components/schemas/CompletenessStatus"
          },
          "stages_compared": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocStage"
            }
          },
          "expected_value": {
            "type": "string",
            "nullable": true
          },
          "actual_value": {
            "type": "string",
            "nullable": true,
            "description": "Значение стадии, которая дала вывод (сработавшая, иначе первая); все стадии — stage_comparisons"
          },
          "delta": {
            "type": "string",
            "nullable": true
          },
          "stage_comparisons": {
            "type": "array",
            "description": "Сравнение с эталоном ПД по каждой стадии (0.17.0): когда сравнивались и РД, и ИД, у каждой своё значение, дельта и вывод. Пусто, если сравнения не было (несопоставимо, нет данных) или протокол собран до 0.17.0.",
            "items": {
              "$ref": "#/components/schemas/StageComparison"
            }
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "review_priority": {
            "$ref": "#/components/schemas/ReviewPriority"
          },
          "risk_level": {
            "$ref": "#/components/schemas/ReviewPriority"
          },
          "rationale": {
            "type": "string",
            "nullable": true,
            "description": "Обоснование (человекочитаемое), самодостаточное: значения стадий, вывод и триггер. Идёт и в выгрузки, где таблицы стадий нет, поэтому числа в нём остаются"
          },
          "trigger_logic": {
            "type": "string",
            "nullable": true,
            "description": "Правило срабатывания из матрицы («Логика ИИ-связи», 0.18.0). Карточке с stage_comparisons достаточно его и таблицы стадий — rationale тогда повторял бы те же числа"
          },
          "rationale_source": {
            "$ref": "#/components/schemas/RationaleSource"
          },
          "normative_reference": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "approved_change_ref": {
            "type": "string",
            "nullable": true,
            "description": "Ссылка на согласованное изменение, если найдено"
          },
          "evidence_group": {
            "$ref": "#/components/schemas/EvidenceGroup"
          },
          "evidence_history": {
            "type": "array",
            "description": "Версии доказательств, от исходной (MODEL) к текущей",
            "items": {
              "$ref": "#/components/schemas/EvidenceVersion"
            }
          },
          "inspector_status": {
            "$ref": "#/components/schemas/InspectorStatus"
          },
          "decision": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingDecision"
              }
            ],
            "nullable": true
          },
          "decision_history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingDecision"
            }
          },
          "parent_finding_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Заполнен у атомарных findings, созданных split"
          },
          "is_split": {
            "type": "boolean",
            "description": "true — составной кандидат, разделённый на атомарные (сам не верифицируется)"
          },
          "evidence_changed": {
            "type": "boolean",
            "description": "Доказательства изменились после дозагрузки — решение сброшено"
          },
          "page_pair_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Пара страниц, на которой показывать finding в режиме сравнения"
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "INSPECTOR",
          "SUPERVISOR",
          "ADMIN",
          "ML_ENGINEER"
        ]
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "login",
          "full_name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        }
      },
      "InspectionResult": {
        "type": "object",
        "description": "Пакет для ИАИС «РиН» — только подтверждённые записи (REQ-INT-05)",
        "required": [
          "process_id",
          "object",
          "protocol_version",
          "versions",
          "confirmed_violations",
          "input_files",
          "finalized_at"
        ],
        "properties": {
          "process_id": {
            "type": "string",
            "format": "uuid"
          },
          "object": {
            "$ref": "#/components/schemas/ObjectInfo"
          },
          "protocol_id": {
            "type": "string",
            "format": "uuid"
          },
          "protocol_version": {
            "type": "integer"
          },
          "versions": {
            "$ref": "#/components/schemas/VersionSet"
          },
          "confirmed_violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "input_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file_id",
                "sha256",
                "original_name"
              ],
              "properties": {
                "file_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string"
                },
                "original_name": {
                  "type": "string"
                },
                "doc_stage": {
                  "$ref": "#/components/schemas/DocStage"
                },
                "document_code": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                }
              }
            }
          },
          "inspector": {
            "$ref": "#/components/schemas/User"
          },
          "finalized_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}